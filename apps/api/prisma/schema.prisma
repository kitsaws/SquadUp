generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(cuid())
  clerkId              String            @unique
  email                String            @unique
  name                 String
  imageUrl             String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  profile              Profile?
  taxonomy             UserTaxonomy?
  preferences          UserPreferences?
  teams                TeamMember[]
  ownedEvents          Event[]
  sentInvites          TeamInvite[]      @relation("SentInvites")
  ownedOrganizers      Organizer[]       @relation("OwnedOrganizers")
  organizerMemberships    OrganizerMember[]
  organizationMemberships OrganizationMembership[]
  teamApplications        TeamApplication[]
}

model Profile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  university           String?
  title                String?
  summary              String?
  skills               String[]
  education            Json?
  experience           Json?
  achievements         Json?
  projects             Json?
  githubUrl            String?
  linkedinUrl          String?
  resumePdfPath        String?
  resumeOriginalName   String?
  lastResumeUploadedAt DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model UserTaxonomy {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxonomyNodeIds String[] @default([])
  rawSkills       String[] @default([])
  evidence        Json?    // Array of TaxonomyEvidenceItem: { nodeId, source, snippet, strength }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Organization {
  id             String                   @id @default(cuid())
  clerkOrgId     String                   @unique // Maps to Clerk's Organization ID
  name           String                   // e.g. "Stanford University"
  slug           String                   @unique // e.g. "stanford"
  domain         String?                  // e.g. "stanford.edu"
  logoUrl        String?
  location       String?
  subOrganizers  Organizer[]              // University clubs/societies
  events         Event[]
  teams          Team[]
  members        OrganizationMembership[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  clerkMemberId  String?      @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("org:member")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
}

model Organizer {
  id             String            @id @default(cuid())
  name           String            // e.g. "ACM Student Chapter"
  slug           String            @unique // e.g. "acm-ucla"
  description    String?
  logoUrl        String?
  website        String?
  email          String?
  orgId          String?           // Clerk Organization ID (University)
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerId        String            // Creator / primary lead
  owner          User              @relation("OwnedOrganizers", fields: [ownerId], references: [id], onDelete: Cascade)
  members        OrganizerMember[]
  events         Event[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model OrganizerMember {
  id          String    @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("ADMIN") // ADMIN, MEMBER
  createdAt   DateTime  @default(now())

  @@unique([organizerId, userId])
}

model Event {
  id                 String        @id @default(cuid())
  title              String
  description        String
  date               DateTime
  location           String?
  organizerId        String
  organizer          User          @relation(fields: [organizerId], references: [id])
  organizerProfileId String?
  organizerProfile   Organizer?    @relation(fields: [organizerProfileId], references: [id], onDelete: SetNull)
  orgId              String?       // Clerk Organization ID
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isGlobal           Boolean       @default(false)
  teams              Team[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Team {
  id             String            @id @default(cuid())
  name           String
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orgId          String?           // Clerk Organization ID
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  members        TeamMember[]
  invites        TeamInvite[]
  applications   TeamApplication[]
  requirements   String[]          // e.g., ["React Developer", "UI Designer"]
  university     String?
  taxonomy       TeamTaxonomy?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model TeamTaxonomy {
  id                 String   @id @default(cuid())
  teamId             String   @unique
  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requirementNodeIds String[] @default([])
  rawRequirements    String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String?  // e.g., "Leader", "Member"
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  email     String   // Email of the person being invited
  status    String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt DateTime @default(now())

  @@unique([teamId, email])
}

model TeamApplication {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, WITHDRAWN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
}

model UserPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 1. Theme & Appearance
  themeMode               String   @default("system") // "light" | "dark" | "system"
  palettePreset           String   @default("default") // "default" | "midnight" | "emerald" | "slate" | "custom"
  primaryColor            String?  // Custom primary hex override (e.g. "#2563eb", "#ec4899")
  bannerConfig            Json?    // { type: "gradient" | "image" | "default", gradient?: { color1, color2, angle }, imageUrl?: string, syncTheme: boolean }

  // 2. Notification Settings
  emailNotifications      Boolean  @default(true)
  teamInvitesNotification Boolean  @default(true)
  applicationUpdates      Boolean  @default(true)
  marketingEmails         Boolean  @default(false)

  // 3. Default Options & Matching Preferences
  defaultCampusOnly       Boolean  @default(false) // Filter squads/events by user's campus by default
  openToCollaboration     Boolean  @default(true)  // Availability indicator for squad recruiters
  preferredRoles          String[] @default([])    // Default role preferences (e.g., ["Frontend", "AI Engineer"])

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

