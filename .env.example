# ==============================================================================
# SquadUp Monorepo — Environment Variables Template
# Copy this file to .env in the root directory:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Inference (Groq API for Resume Parsing)
# ------------------------------------------------------------------------------
# API key for the Groq LLM inference service (e.g., https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Core Backend Infrastructure (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma ORM
DATABASE_URL=postgresql://postgres:password@localhost:5433/squadup?schema=public

# Redis connection string used by BullMQ background jobs and CacheService
REDIS_URL=redis://localhost:6379

# Set to "true" to bypass the 24-hour resume upload rate limit during development
# BYPASS_RESUME_RATE_LIMIT=true

# ------------------------------------------------------------------------------
# 3. Clerk Authentication
# ------------------------------------------------------------------------------
# Publishable keys (Frontend Vite app and Backend validation)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Secret key used by Express backend SDK to authenticate requests and query Clerk API
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ------------------------------------------------------------------------------
# 4. Clerk / Svix Webhooks
# ------------------------------------------------------------------------------
# CLERK_WEBHOOK_SECRET:
#   Cryptographic signing secret provided by Clerk/Svix (starts with `whsec_...`).
#   Used by the webhook controller to verify incoming svix-signature headers.
CLERK_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# CLERK_WEBHOOK_URL:
#   The externally reachable base/receiving URL where Clerk/Svix delivers webhook POST events.
#   - LOCAL DEVELOPMENT:
#     When using a tunnel tool like ngrok (e.g., `ngrok http 3000`), set this to your public tunnel URL:
#     CLERK_WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app/api/webhooks
#   - PRODUCTION:
#     Set to your production backend domain:
#     CLERK_WEBHOOK_URL=https://api.squadup.dev/api/webhooks
CLERK_WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app/api/webhooks
